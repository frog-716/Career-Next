{
  "name": "career-next",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/desktop",
    "packages/contracts",
    "packages/backend",
    "packages/frontend"
  ],
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "description": "Career-Next: personal Raw vertical slice",
  "main": "dist/application/main.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/g1-build.mjs",
    "test": "vitest run tests/materials-state.test.ts tests/materials-boundaries.test.ts",
    "native:rebuild": "electron-rebuild --force --only better-sqlite3",
    "dev": "electron .",
    "smoke:dev": "vitest run tests/desktop/materials.electron.test.ts",
    "package": "electron-forge package --platform=darwin --arch=arm64",
    "smoke:packaged": "CAREER_PACKAGED=1 vitest run tests/desktop/materials.electron.test.ts",
    "install:electron": "install-electron",
    "package:x64": "electron-forge package --platform=darwin --arch=x64",
    "build:g0": "node scripts/g0-build.mjs",
    "test:g0": "vitest run tests/g0.unit.test.ts",
    "test:integration": "node scripts/g1-integration-build.mjs && vitest run tests/integration",
    "smoke:g0": "vitest run tests/g0.electron.test.ts"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron/rebuild": "4.2.0",
    "@tanstack/react-query": "5.103.1",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.5.1",
    "kysely": "0.29.6",
    "node": "24.21.0",
    "pdfjs-dist": "6.3.289",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-router": "8.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
