{
  "name": "career-next",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/desktop",
    "packages/contracts",
    "packages/backend",
    "packages/frontend"
  ],
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "description": "Career-Next: local career workspace, G4 cross-domain transactions and local AI proposals",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/g1-build.mjs",
    "test": "vitest run tests --exclude 'tests/integration/**' --exclude 'tests/desktop/**' --maxWorkers=1",
    "dev": "node scripts/career.mjs",
    "package": "node scripts/package-macos.mjs",
    "test:integration": "node scripts/g1-integration-build.mjs && vitest run tests/integration --maxWorkers=1",
    "generate": "node scripts/generate-modules.mjs",
    "prebuild": "npm run generate",
    "pretypecheck": "npm run generate",
    "start": "node scripts/career.mjs",
    "stop": "node scripts/career.mjs stop",
    "test:browser": "vitest run tests/desktop --maxWorkers=1"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.103.1",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "kysely": "0.29.6",
    "node": "24.21.0",
    "pdfjs-dist": "6.3.289",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-router": "8.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
